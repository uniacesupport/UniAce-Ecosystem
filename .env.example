# MISTRAL_API_KEY: Optional secondary AI provider.
MISTRAL_API_KEY=""

# GROQ_API_KEY: Extremely fast AI provider.
GROQ_API_KEY=""

# GEMINI_API_KEY: Google AI provider.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Required for AI features.
# Configure this in the AI Studio Secrets panel.
OPENROUTER_API_KEY=""

# ACTIVE_AI_PROVIDER: Set to 'gemini' or 'openrouter'
ACTIVE_AI_PROVIDER="openrouter"
VITE_ACTIVE_AI_PROVIDER="openrouter"

# VITE_PAYSTACK_PUBLIC_KEY: Required for Paystack integration (Client-side).
# Configure this in the AI Studio Secrets panel.
VITE_PAYSTACK_PUBLIC_KEY=""

# PAYSTACK_SECRET_KEY: Required for Paystack webhook and payment verification (Server-side).
# Configure this in the AI Studio Secrets panel.
PAYSTACK_SECRET_KEY=""

# FIREBASE_SERVICE_ACCOUNT: Complete Firebase Service Account JSON object.
# Configure this in the AI Studio Secrets panel.
FIREBASE_SERVICE_ACCOUNT=""

# WHATSAPP_API_KEY: Private API key for WhatsApp integration (Server-side).
WHATSAPP_API_KEY=""

# WHATSAPP_PHONE_NUMBER_ID: The ID of the phone number used for WhatsApp Business API.
WHATSAPP_PHONE_NUMBER_ID=""

# SMTP Configuration for Emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
