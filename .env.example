# --- AI PROVIDER KEYS ---
# NOTE: You can provide multiple keys for any provider by separating them with commas.
# Example: GEMINI_API_KEY="key1,key2,key3"
# The system will automatically rotate between them and skip exhausted ones.

# MISTRAL_API_KEY: Optional secondary AI provider.
MISTRAL_API_KEY=""

# GROQ_API_KEY: Extremely fast AI provider.
GROQ_API_KEY=""

# GEMINI_API_KEY: Google AI provider.
# NVIDIA_API_KEY: Required for High Quality FLUX Image generation and advanced STEM.
NVIDIA_API_KEY=""

GEMINI_API_KEY=""

# COHERE_API_KEY: Cohere AI provider.
COHERE_API_KEY=""

# HUGGINGFACE_API_KEY: Hugging Face AI provider.
HUGGINGFACE_API_KEY=""

# OPENROUTER_API_KEY: Required for AI features.
# Configure this in the AI Studio Secrets panel.
OPENROUTER_API_KEY=""

# ACTIVE_AI_PROVIDER: Set to 'nvidia', 'gemini', or 'openrouter'
ACTIVE_AI_PROVIDER="openrouter"
VITE_ACTIVE_AI_PROVIDER="openrouter"

# VITE_PAYSTACK_PUBLIC_KEY: Required for Paystack integration (Client-side).
# Configure this in the AI Studio Secrets panel.
VITE_PAYSTACK_PUBLIC_KEY=""

# PAYSTACK_SECRET_KEY: Required for Paystack webhook and payment verification (Server-side).
# Configure this in the AI Studio Secrets panel.
PAYSTACK_SECRET_KEY=""

# FIREBASE_SERVICE_ACCOUNT: Complete Firebase Service Account JSON object.
# Configure this in the AI Studio Secrets panel.
FIREBASE_SERVICE_ACCOUNT=""

# --- OPTION B: SUPABASE POSTGRES ROADMAP CONFIGURATION ---
# SUPABASE_URL: Project URL from Supabase dashboard (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=""
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public Anonymous Key for Supabase client
SUPABASE_ANON_KEY=""
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Private Service Role Key for backend administration
SUPABASE_SERVICE_ROLE_KEY=""

# SUPABASE_DATABASE_URL: PostgreSQL Connection String for Drizzle ORM
SUPABASE_DATABASE_URL=""


# WHATSAPP_API_KEY: Private API key for WhatsApp integration (Server-side).
WHATSAPP_API_KEY=""

# WHATSAPP_PHONE_NUMBER_ID: The ID of the phone number used for WhatsApp Business API.
WHATSAPP_PHONE_NUMBER_ID=""

# SMTP Configuration for Emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""

# --- ADMIN AND SUPPORT EMAILS ---
# Comma-separated list of admin emails (Server-side)
ADMIN_EMAILS="admin@example.com,support@example.com"
# Comma-separated list of admin emails (Client-side)
VITE_ADMIN_EMAILS="admin@example.com,support@example.com"
# Primary support email (Server-side)
SUPPORT_EMAIL="support@example.com"
# Primary support email (Client-side)
VITE_SUPPORT_EMAIL="support@example.com"

# --- DEV & HMR PORT CONFIGURATION ---
VITE_PORT="3000"
VITE_HMR_PORT="24679"
VITE_HMR_CLIENT_PORT=""
