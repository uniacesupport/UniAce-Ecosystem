rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      let isBootstrapAdmin = (request.auth.token.email == 'uniace.support@gmail.com' || request.auth.token.email == 'olalekan4565@gmail.com') && request.auth.token.email_verified;
      let isRoleAdmin = isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      return isBootstrapAdmin || isRoleAdmin;
    }
    
    function isEditor() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() < 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 500)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 2000)) &&
             (!('role' in data) || (data.role in ['student', 'admin', 'editor'])) &&
             (!('plan_type' in data) || (data.plan_type in ['free', 'pro', 'scholar', 'exam_cram', 'semester'])) &&
             (!('xp' in data) || (data.xp is number && data.xp >= 0)) &&
             (!('level' in data) || (data.level is number && data.level >= 0)) &&
             (!('streak' in data) || (data.streak is number && data.streak >= 0)) &&
             (!('themeColor' in data) || (data.themeColor is string && data.themeColor.size() < 50)) &&
             (!('rank' in data) || (data.rank is string && data.rank.size() < 50)) &&
             (!('sessionId' in data) || (data.sessionId is string && data.sessionId.size() < 100)) &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() < 500)) &&
             (!('lastStudyDate' in data) || (data.lastStudyDate is string && data.lastStudyDate.size() < 50)) &&
             (!('mastery' in data) || (data.mastery is map)) &&
             (!('achievements' in data) || (data.achievements is list && data.achievements.size() < 1000)) &&
             (!('studyTime' in data) || (data.studyTime is map)) &&
             (!('topicLastStudied' in data) || (data.topicLastStudied is map)) &&
             (!('bookmarks' in data) || (data.bookmarks is list && data.bookmarks.size() < 1000)) &&
             (!('enrolledCourses' in data) || (data.enrolledCourses is list && data.enrolledCourses.size() < 100)) &&
             (!('assignments' in data) || (data.assignments is list && data.assignments.size() < 100)) &&
             (!('learningProfile' in data) || (data.learningProfile is map)) &&
             (!('last_nudge_date' in data) || (data.last_nudge_date is string && data.last_nudge_date.size() < 50)) &&
             (!('last_nudge_message' in data) || (data.last_nudge_message is string && data.last_nudge_message.size() < 1000));
    }

    function isValidStudyPlan(data) {
      return data.userId == request.auth.uid &&
             data.timetable is list && data.timetable.size() < 100 &&
             data.exams is list && data.exams.size() < 50 &&
             data.sessions is list && data.sessions.size() < 200 &&
             data.lastGenerated is string && data.lastGenerated.size() < 50 &&
             data.id is string && data.id.size() < 100;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() < 2000 &&
             (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidSupportChat(data) {
      return data.userId == request.auth.uid &&
             (!('subject' in data) || (data.subject is string && data.subject.size() < 200)) &&
             (!('status' in data) || data.status in ['open', 'closed', 'pending']);
    }

    function isValidBattle(data) {
      return (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() < 100)) &&
             (!('opponentId' in data) || (data.opponentId is string && data.opponentId.size() < 100)) &&
             (!('status' in data) || data.status in ['waiting', 'active', 'completed', 'cancelled']) &&
             (!('courseId' in data) || (data.courseId is string && data.courseId.size() < 100));
    }

    function isValidSpacedRepetition(data) {
      return data.userId == request.auth.uid &&
             data.topicId is string && data.topicId.size() < 100 &&
             data.courseId is string && data.courseId.size() < 100 &&
             data.topicTitle is string && data.topicTitle.size() < 200 &&
             data.easinessFactor is number && data.easinessFactor >= 1.3 &&
             data.interval is number && data.interval >= 0 &&
             data.repetitions is number && data.repetitions >= 0 &&
             (data.nextReviewDate is string || data.nextReviewDate is timestamp) &&
             (data.lastReviewed is string || data.lastReviewed is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /study_plans/{userId} {
      allow read, write: if isAdmin();
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidStudyPlan(request.resource.data) && hasRequiredFields(['id', 'userId', 'timetable', 'exams', 'sessions', 'lastGenerated']);
      allow update: if isOwner(userId) && isValidStudyPlan(request.resource.data) && request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow get, list, write: if isAdmin();
      allow get: if isOwner(userId);
      
      allow update: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan_type', 'ai_sparks', 'subscription_expiry', 'subscription_status', 'subscription_start_date', 'last_spark_reset', 'last_payment_ref']) || isAdmin());
      
      allow create: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      hasRequiredFields(['uid', 'email', 'displayName', 'role', 'plan_type']) &&
                      (request.resource.data.role == 'student' || isAdmin()) &&
                      (request.resource.data.plan_type == 'free' || isAdmin()) &&
                      (request.resource.data.get('ai_sparks', 0) <= 50 || isAdmin()) &&
                      (!('subscription_status' in request.resource.data) || request.resource.data.subscription_status == 'none' || isAdmin());

      match /spaced_repetition/{topicId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidSpacedRepetition(request.resource.data);
        allow update: if isOwner(userId) && isValidSpacedRepetition(request.resource.data) && request.resource.data.userId == resource.data.userId;
        allow delete: if isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                    (notificationId == 'global_alert' || resource == null || resource.data.userId == request.auth.uid || resource.data.userId == 'global');
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /support_chats/{chatId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidSupportChat(request.resource.data);
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
                    isValidSupportChat(request.resource.data) &&
                    request.resource.data.userId == resource.data.userId;
      
      match /messages/{messageId} {
        allow read, write: if isAdmin();
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid;
        allow create: if isAuthenticated() && 
                      get(/databases/$(database)/documents/support_chats/$(chatId)).data.userId == request.auth.uid &&
                      isValidMessage(request.resource.data);
      }
    }

    match /payments/{paymentId} {
      allow read, write: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid && 
                    (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /battles/{battleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid && isValidBattle(request.resource.data);
      allow update: if isAuthenticated() && 
                    isValidBattle(request.resource.data) &&
                    (
                      (resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == resource.data.creatorId) ||
                      (request.auth.uid == request.resource.data.opponentId && (!('opponentId' in resource.data) || resource.data.opponentId == request.auth.uid))
                    ) && 
                    request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isEditor();

      match /{subcollection}/{docId=**} {
         allow read: if isAuthenticated();
         allow write: if isEditor();
      }
    }

    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid &&
                    (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() < 5000)) &&
                    (!('details' in request.resource.data) || (request.resource.data.details is string && request.resource.data.details.size() < 10000) || request.resource.data.details is map);
      allow update, delete: if false;
    }

    match /knowledge_base/{docId} {
      allow read: if isAuthenticated();
      allow write: if isEditor();
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
